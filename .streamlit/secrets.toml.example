# Copy to .streamlit/secrets.toml (git-ignored) and fill in real values.
# On Streamlit Community Cloud paste the same keys into App settings -> Secrets.

# LLM provider: groq | openrouter | gemini | ollama
LLM_PROVIDER = "groq"
LLM_MODEL = ""            # empty = provider default (groq: openai/gpt-oss-120b)
LLM_API_KEY = ""          # https://console.groq.com/keys

# NCBI E-utilities (PubMed). Both optional; a key raises the limit from 3 to 10 req/s.
NCBI_API_KEY = ""         # https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL = ""           # contact email NCBI asks API clients to send
